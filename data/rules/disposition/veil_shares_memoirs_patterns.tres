[gd_resource type="Resource" script_class="Rule" format=3]

[ext_resource type="Script" path="res://scripts/data/rules/rule.gd" id="1_rule"]

[resource]
script = ExtResource("1_rule")
id = &"veil_shares_memoirs_patterns"
condition = "event.action_type == \"plant_idea\" and target != null and target.get(\"profession\") in [\"scholar\", \"librarian\", \"philosopher\", \"academy_master\"]"
base_delta = 15
attribution_tag = &"veil_shares_memoirs_scholarly"
