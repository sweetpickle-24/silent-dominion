[gd_resource type="Resource" script_class="Rule" format=3]

[ext_resource type="Script" path="res://scripts/data/rules/rule.gd" id="1_rule"]

[resource]
script = ExtResource("1_rule")
id = &"veil_recruits_cultivated_scholar"
condition = "event.action_type in [\"cultivate_to_host\", \"cultivate\", \"recruit_to_witting\"] and target != null and target.get(\"profession\") in [\"scholar\", \"librarian\", \"philosopher\"]"
base_delta = -25
attribution_tag = &"veil_recruits_cultivated_scholar"
