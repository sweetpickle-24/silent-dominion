[gd_resource type="Resource" script_class="Rule" format=3]

[ext_resource type="Script" path="res://scripts/data/rules/rule.gd" id="1_rule"]

[resource]
script = ExtResource("1_rule")
id = &"veil_corrupts_academy"
condition = "event.action_type == \"corrupt_institution\" and target != null and target.place_type in [\"academy\"]"
base_delta = -90
attribution_tag = &"veil_corrupts_academy_direct_attack"
