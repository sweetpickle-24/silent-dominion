[gd_resource type="Resource" script_class="SocietyAIRule" format=3]

[ext_resource type="Script" path="res://scripts/data/records/society_ai_rule.gd" id="1_rule"]

[resource]
script = ExtResource("1_rule")
id = &"veil:expand_to_egypt"
society_id = &"the_veil"
priority = 135
rule_tier = &"strategic"
description = "When game year > 100 AND Egypt is stable AND no Veil operative in Naucratis or Memphis, cultivate a scholar there. Growth arc: expansion beyond Greece."
condition = "world.year > 100"
action_kind = &"dispatch_scheme"
action_params = {"action_type": "cultivate_to_host", "target_selector": "specific_place", "target_constraints": {"place_id": "memphis"}}
cooldown_days = 3650
