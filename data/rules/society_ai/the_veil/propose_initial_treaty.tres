[gd_resource type="Resource" script_class="SocietyAIRule" format=3]

[ext_resource type="Script" path="res://scripts/data/records/society_ai_rule.gd" id="1_rule"]

[resource]
script = ExtResource("1_rule")
id = &"veil:propose_initial_treaty"
society_id = &"the_veil"
priority = 75
rule_tier = &"diplomatic"
description = "When first contact has been reciprocated and channel is open, propose a small mutual non-aggression + no-host-recruitment treaty."
condition = "true"
action_kind = &"dispatch_scheme"
action_params = {"action_type": "observe", "target_selector": "specific_place", "target_constraints": {"place_id": "athens"}}
cooldown_days = 3650
reactive_trigger_event_classes = Array[StringName]([&"FirstContactEvent"])
