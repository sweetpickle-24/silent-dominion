[gd_resource type="Resource" script_class="SocietyAIRule" format=3]

[ext_resource type="Script" path="res://scripts/data/records/society_ai_rule.gd" id="1_rule"]

[resource]
script = ExtResource("1_rule")
id = &"veil:gather_intel_on_player"
society_id = &"the_veil"
priority = 90
rule_tier = &"operational"
description = "When Fingerprint Level 1+ on player exists AND a recent scheme fired in a Veil-monitored region, gather intelligence there. Reactive timing."
condition = "true"
action_kind = &"dispatch_scheme"
action_params = {"action_type": "gather_intelligence", "target_selector": "random_scholarly_city", "target_constraints": {}}
cooldown_days = 180
reactive_trigger_event_classes = Array[StringName]([&"SchemeResolvedEvent"])
