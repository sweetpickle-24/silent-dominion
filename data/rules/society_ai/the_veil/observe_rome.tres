[gd_resource type="Resource" script_class="SocietyAIRule" format=3]

[ext_resource type="Script" path="res://scripts/data/records/society_ai_rule.gd" id="1_viqes"]

[resource]
script = ExtResource("1_viqes")
id = &"the_veil:observe_rome"
society_id = &"the_veil"
priority = 200
description = "Long-horizon Rome observation"
condition = "world.day > 36500"
action_params = {
"action_type": &"observe",
"target_constraints": {
"place_id": &"rome"
},
"target_selector": &"specific_place"
}
cooldown_days = 3650
