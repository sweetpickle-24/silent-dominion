[gd_resource type="Resource" script_class="SocietyAIRule" format=3]

[ext_resource type="Script" path="res://scripts/data/records/society_ai_rule.gd" id="1_5yip3"]

[resource]
script = ExtResource("1_5yip3")
id = &"the_veil:gather_intel_scholarly"
