[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"first_contact_received_gifted_pattern"
triggering_event_class = &"FirstContactEvent"
sender_kind = &"intermediary"
subject_variants = Array[String](["A sealed philosophical text", "A gift from an unknown hand"])
body_variants = Array[String](["A sealed philosophical text arrives at your door. Inside, beyond the surface meaning, a fully-articulated pattern of manipulation — refined over centuries by another hand. A gift. Whoever sent this understands the craft as you do.", "Among routine correspondence, a document stands apart. Its surface is philosophy; its depth is technique — a pattern of influence honed by long practice. Someone who shares your nature has made a gift of their knowledge."])
content_category = &"first_contact"
is_authored = true
