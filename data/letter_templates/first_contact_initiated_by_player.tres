[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"first_contact_initiated_by_player"
triggering_event_class = &"FirstContactEvent"
sender_kind = &"system"
subject_variants = Array[String](["First contact initiated", "You have reached out"])
body_variants = Array[String](["You have made first contact. Through your network's intermediaries, the organisation you detected has been quietly informed that you exist. The opening was made. Now you wait to see how they respond.", "Your intermediaries have carried word to the unknown organisation. The gesture has been made. Whether they reciprocate, ignore, or respond with hostility remains to be seen."])
content_category = &"first_contact"
is_authored = true
