[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"ruler_died_succession"
triggering_event_class = &"RulerSucceededEvent"
sender_kind = &"system"
subject_variants = Array[String](["A ruler has fallen", "Succession in {kingdom_name}"])
body_variants = Array[String](["The ruler of {kingdom_name} has died. A successor has taken the throne. Legitimacy has been affected.", "{kingdom_name} has a new ruler following the death of the previous one. The transition was {succession_type}."])
content_category = &"succession"
is_authored = true
