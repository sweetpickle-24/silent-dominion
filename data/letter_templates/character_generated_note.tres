[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"character_generated_note"
triggering_event_class = &"CharacterGeneratedEvent"
sender_kind = &"system"
subject_variants = Array[String](["A new figure emerges", "New individual of note"])
body_variants = Array[String](["A new figure has emerged at {place_name}.", "A new individual has come to prominence at {place_name}."])
content_category = &"demographics"
is_authored = true
