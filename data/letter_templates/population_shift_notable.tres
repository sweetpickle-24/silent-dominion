[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"population_shift_notable"
triggering_event_class = &"PopulationDeltaAppliedEvent"
sender_kind = &"system"
subject_variants = Array[String](["Population change", "Demographic shift"])
body_variants = Array[String](["Population at {place_name} has shifted by {delta} to {new_population}.", "A notable demographic change at {place_name}: population now at {new_population}."])
content_category = &"demographics"
is_authored = true
