[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"treaty_accepted_by_them"
triggering_event_class = &"TreatyAcceptedEvent"
sender_kind = &"intermediary"
subject_variants = Array[String](["Terms accepted", "A treaty is signed"])
body_variants = Array[String](["The other party has accepted your terms. A treaty is now in force. Both parties are bound by the agreed primitives. Honour builds reputation; violation destroys it.", "Agreement reached. The treaty is sealed. From this day forward, the terms bind both parties. Your reputation as a treaty partner begins to accumulate."])
content_category = &"treaty"
is_authored = true
