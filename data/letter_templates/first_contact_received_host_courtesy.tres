[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"first_contact_received_host_courtesy"
triggering_event_class = &"FirstContactEvent"
sender_kind = &"intermediary"
subject_variants = Array[String](["A courtesy between practitioners", "Regarding a mutual acquaintance"])
body_variants = Array[String](["Word reaches you indirectly: a fellow long-lived practitioner has noticed your interest in a certain individual. They propose, not as a treaty but as a courtesy between practitioners, that neither attempt to recruit this person without consulting the other.", "A discreet message arrives through unclear channels. Another immortal — or their agent — proposes a simple understanding regarding a person both of you have noticed. Not a formal agreement. A courtesy."])
content_category = &"first_contact"
is_authored = true
