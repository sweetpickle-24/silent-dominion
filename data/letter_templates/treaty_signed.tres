[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"treaty_signed"
triggering_event_class = &"TreatySignedEvent"
sender_kind = &"system"
subject_variants = Array[String](["Treaty in force", "Agreement sealed"])
body_variants = Array[String](["A treaty between two immortal organisations is now in force. The agreed terms bind both parties. Reputation will accumulate with each year the treaty is honoured.", "The treaty is active. Both signatories are now bound by its terms. Time will tell whether it endures."])
content_category = &"treaty"
is_authored = true
