[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"kingdom_tax_level_changed"
triggering_event_class = &"KingdomTaxLevelChangedEvent"
sender_kind = &"system"
subject_variants = Array[String](["Tax policy change", "Taxation adjusted"])
body_variants = Array[String](["The ruler of {kingdom_name} has adjusted taxation from {old_level} to {new_level}.", "Tax policy in {kingdom_name} has been revised."])
content_category = &"kingdom_intel"
is_authored = true
