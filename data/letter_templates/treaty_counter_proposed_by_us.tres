[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"treaty_counter_proposed_by_us"
triggering_event_class = &"TreatyCounterProposedEvent"
sender_kind = &"system"
subject_variants = Array[String](["Counter-proposal sent", "Modified terms conveyed"])
body_variants = Array[String](["Your counter-proposal has been sent. The other party will evaluate your modifications.", "Your modified terms are in transit. The negotiation continues."])
content_category = &"treaty"
is_authored = true
