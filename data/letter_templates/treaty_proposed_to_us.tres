[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"treaty_proposed_to_us"
triggering_event_class = &"TreatyProposedEvent"
sender_kind = &"intermediary"
subject_variants = Array[String](["A formal proposal arrives", "Terms for consideration"])
body_variants = Array[String](["Through intermediaries, a formal diplomatic proposal has been conveyed. The other party proposes specific terms of cooperation. Review the terms carefully — each primitive carries weight.", "A treaty proposal has arrived through deniable channels. The terms are laid out formally: obligations, restraints, and mutual commitments. Your response will shape the relationship for years to come."])
content_category = &"treaty"
is_authored = true
