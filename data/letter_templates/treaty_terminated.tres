[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"treaty_terminated"
triggering_event_class = &"TreatyTerminatedEvent"
sender_kind = &"system"
subject_variants = Array[String](["Treaty terminated", "An agreement ends"])
body_variants = Array[String](["A treaty has been terminated before its natural expiry. The diplomatic relationship has been damaged. Future negotiations will be more difficult.", "The treaty is over — ended by one party's decision. The consequences ripple through the diplomatic landscape."])
content_category = &"treaty"
is_authored = true
