[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"first_contact_response_ignored"
triggering_event_class = &"FirstContactEvent"
sender_kind = &"system"
subject_variants = Array[String](["Silence", "No response"])
body_variants = Array[String](["The other party has not responded to your opening gesture. This may mean caution, disinterest, or simply that they are taking their time. The channel remains open but unconfirmed.", "Your gesture was met with silence. Whether this is deliberate snub or careful consideration, you cannot yet tell. The situation remains ambiguous."])
content_category = &"first_contact"
is_authored = true
