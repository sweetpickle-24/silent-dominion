[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_tvaw1"]

[resource]
script = ExtResource("1_tvaw1")
id = &"pattern_went_stale"
triggering_event_class = &"PatternStalenessChangedEvent"
subject_variants = Array[String](["A pattern fades", "On obsolescence"])
