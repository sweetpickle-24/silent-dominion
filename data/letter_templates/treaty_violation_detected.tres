[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"treaty_violation_detected"
triggering_event_class = &"TreatyViolationDetectedEvent"
sender_kind = &"system"
subject_variants = Array[String](["Treaty violation detected", "A breach of terms"])
body_variants = Array[String](["A violation of an active treaty has been detected. The action taken contradicts the agreed terms. The violation has been recorded and the counterparty notified. Reputation consequences follow.", "One party has broken the terms of an active treaty. This violation is now part of the diplomatic record. Trust erodes; reputation suffers."])
content_category = &"treaty"
is_authored = true
