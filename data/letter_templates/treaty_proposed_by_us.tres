[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"treaty_proposed_by_us"
triggering_event_class = &"TreatyProposedEvent"
sender_kind = &"system"
subject_variants = Array[String](["Treaty proposal sent", "Your terms have been conveyed"])
body_variants = Array[String](["Your treaty proposal has been conveyed through intermediaries. The other party will evaluate your terms. Expect a response — acceptance, rejection, or counter-proposal.", "The proposal is sent. Now you wait. The counterparty may accept, reject, or modify your terms."])
content_category = &"treaty"
is_authored = true
