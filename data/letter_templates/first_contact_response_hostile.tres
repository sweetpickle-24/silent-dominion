[gd_resource type="Resource" script_class="LetterTemplate" format=3]

[ext_resource type="Script" path="res://scripts/data/records/letter_template.gd" id="1_lt"]

[resource]
script = ExtResource("1_lt")
id = &"first_contact_response_hostile"
triggering_event_class = &"FirstContactEvent"
sender_kind = &"system"
subject_variants = Array[String](["A hostile response", "They chose confrontation"])
body_variants = Array[String](["Rather than reciprocate or ignore your gesture, the other party has responded with hostility — actions targeting your interests have intensified since contact was made. The message is clear: they see you as a threat, not a potential ally.", "Your overture was answered not with words but with action against your network. The organisation you contacted has declared its intentions through hostility. Diplomatic options remain limited."])
content_category = &"first_contact"
is_authored = true
